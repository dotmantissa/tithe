NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
DATABASE_URL=
# Generate a 32 byte hex secret. Back it up securely; it controls managed accounts.
ACCOUNT_DERIVATION_SECRET=
INDEXER_SECRET=
# Vercel daily fallback and GitHub Actions five-minute maintenance use this secret.
# Also configure the same value as the encrypted repository secret TITHE_CRON_SECRET.
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Deployment only. Never needed by the web app.
GENLAYER_DEPLOYER_KEY=

# Self-hosting only: optional header overwritten by a trusted sanitizing proxy.
# Without it anonymous callers share a single safe rate-limit bucket.
TRUSTED_CLIENT_IP_HEADER=
